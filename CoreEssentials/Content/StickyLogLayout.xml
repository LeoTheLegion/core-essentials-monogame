<?xml version="1.0" encoding="utf-8"?>
<!--
    StickyLog grid layout — embedded resource for GuiSerializer.

    The Grid is intentionally empty here; individual key-value label pairs
    are added dynamically at runtime via StickyLog.CreateNewLabel().

    Background is set declaratively using a hex ARGB color:
      #64 = 100/255 ≈ 39% opacity, 000000 = black.
-->
<Grid Width="300" Height="100" RowSpacing="8" ColumnSpacing="8" Visible="true" Background="#64000000">
    <!-- No child widgets — labels added dynamically at runtime -->
</Grid>
