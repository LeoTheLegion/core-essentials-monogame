<Scene>
    <!--
        Fully data-driven anchored GUI demo (mirrors Unity's RectTransform anchoring).

        Strict scene format: <Scene> -> <GameSystems> -> <System Type="EntitySystem">.
        One root GameObjectEntity carries the CanvasComponent; every HUD element is a child
        composed of an AnchorComponent (preset + pixel offset) plus a LabelComponent or
        ButtonComponent. No per-element game code — button command wiring and key navigation
        are all declarative (<Bind> elements and NavigateOnKeyComponent in this file).

        Anchors are normalized screen points: (0,0) = top-left, (1,1) = bottom-right.

        The title and both buttons render in the custom ComicMono.ttf typeface via each widget's
        FontAsset/FontSize — loaded as raw bytes from Content/Fonts by GuiFontLoader (not through the
        content pipeline). Labels without a FontAsset keep the engine default font.

        Button backgrounds: "Add 10" sets BackgroundTint to draw a solid box; "Reset" leaves it null
        (the transparent default) so only its text is drawn — a side-by-side of both modes.
    -->
    <GameSystems>
        <System Type="EntitySystem">
            <Entities>
                <EntityDefinition
                    Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity"
                    Id="hud">
                    <Position X="0" Y="0" />
                    <Components>
                        <Component Type="CanvasComponent" />
                        <Component Type="AnchorComponent">
                            <Properties>
                                <Property Name="Preset" Value="TopLeft" />
                                <Property Name="Offset" Value="0,0" />
                            </Properties>
                        </Component>
                        <!-- Score state lives in a component on the HUD root; both buttons below
                        bind
                 their Clicked events to its public methods. -->
                        <Component Type="ScoreKeeperComponent" />
                    </Components>
                    <References>
                        <!-- Injects the score label entity into ScoreKeeperComponent.ScoreLabel. -->
                        <Reference Name="ScoreLabel" TargetId="scoreText" />
                    </References>

                    <Children>
                        <!-- Title: top edge, centered horizontally -->
                        <EntityDefinition
                            Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity"
                            Id="titleText">
                            <Components>
                                <Component Type="AnchorComponent">
                                    <Properties>
                                        <Property Name="Preset" Value="TopCenter" />
                                        <Property Name="Offset" Value="0,40" />
                                    </Properties>
                                </Component>
                                <Component Type="LabelComponent">
                                    <Properties>
                                        <Property Name="Text"
                                            Value="CORE ESSENTIALS — ANCHORED GUI DEMO" />
                                        <Property Name="TextColor" Value="White" />
                                        <Property Name="Scale" Value="2,2" />
                                        <Property Name="FontAsset" Value="Fonts/ComicMono.ttf" />
                                        <Property Name="FontSize" Value="24" />
                                    </Properties>
                                </Component>
                            </Components>
                        </EntityDefinition>

                        <!-- Score: top-left corner (updated live at runtime by the scene) -->
                        <EntityDefinition
                            Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity"
                            Id="scoreText">
                            <Components>
                                <Component Type="AnchorComponent">
                                    <Properties>
                                        <Property Name="Preset" Value="TopLeft" />
                                        <Property Name="Offset" Value="16,16" />
                                    </Properties>
                                </Component>
                                <Component Type="LabelComponent">
                                    <Properties>
                                        <Property Name="Text" Value="Score: 0" />
                                        <Property Name="TextColor" Value="Lime" />
                                    </Properties>
                                </Component>
                            </Components>
                        </EntityDefinition>

                        <!-- Hint: bottom edge, centered horizontally -->
                        <EntityDefinition
                            Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity"
                            Id="hintText">
                            <Components>
                                <Component Type="AnchorComponent">
                                    <Properties>
                                        <Property Name="Preset" Value="BottomCenter" />
                                        <Property Name="Offset" Value="0,-32" />
                                    </Properties>
                                </Component>
                                <Component Type="LabelComponent">
                                    <Properties>
                                        <Property Name="Text"
                                            Value="Click the buttons to change the score | Esc for next scene" />
                                        <Property Name="TextColor" Value="Gray" />
                                    </Properties>
                                </Component>
                            </Components>
                        </EntityDefinition>

                        <!-- Buttons: left edge, vertically centered -->
                        <EntityDefinition
                            Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity"
                            Id="addScoreButton">
                            <Components>
                                <Component Type="AnchorComponent">
                                    <Properties>
                                        <Property Name="Preset" Value="MiddleLeft" />
                                        <Property Name="Offset" Value="16,-25" />
                                    </Properties>
                                </Component>
                                <Component Type="ButtonComponent">
                                    <Properties>
                                        <Property Name="Text" Value="Add 10" />
                                        <Property Name="FontAsset" Value="Fonts/ComicMono.ttf" />
                                        <Property Name="FontSize" Value="18" />
                                        <Property Name="BackgroundTint" Value="CornflowerBlue" />
                                    </Properties>
                                </Component>
                                <!-- Declarative wiring: no FindById + subscribe code in the scene. -->
                                <Bind Event="Clicked" Command="AddTen" />
                            </Components>
                        </EntityDefinition>

                        <EntityDefinition
                            Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity"
                            Id="resetButton">
                            <Components>
                                <Component Type="AnchorComponent">
                                    <Properties>
                                        <Property Name="Preset" Value="MiddleLeft" />
                                        <Property Name="Offset" Value="16,25" />
                                    </Properties>
                                </Component>
                                <Component Type="ButtonComponent">
                                    <Properties>
                                        <Property Name="Text" Value="Reset" />
                                        <Property Name="FontAsset" Value="Fonts/ComicMono.ttf" />
                                        <Property Name="FontSize" Value="18" />
                                        <!-- Themed background: a sprite plate stretched to fill the button,
                         tinted by BackgroundColor. The sprite wins over any BackgroundTint. -->
                                        <Property Name="BackgroundAsset" Value="Sprites/button_plate.xml" />
                                        <Property Name="BackgroundColor" Value="Tomato" />
                                    </Properties>
                                </Component>
                                <Bind Event="Clicked" Command="Reset" />
                            </Components>
                        </EntityDefinition>
                    </Children>
                </EntityDefinition>

                <!--
        World-space panel: a second root with a world-space canvas (IsScreenSpace=false) and an
        explicit size in world units. Its anchored children live INSIDE the panel, so moving the
        camera (WASD) or the panel drags the whole anchored layout around the world.
    -->
                <EntityDefinition
                    Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity"
                    Id="worldPanel">
                    <Position X="640" Y="360" />
                    <Components>
                        <Component Type="CanvasComponent">
                            <Properties>
                                <Property Name="IsScreenSpace" Value="false" />
                                <Property Name="Width" Value="320" />
                                <Property Name="Height" Value="200" />
                            </Properties>
                        </Component>
                    </Components>

                    <Children>
                        <EntityDefinition
                            Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity"
                            Id="panelTitleText">
                            <Components>
                                <Component Type="AnchorComponent">
                                    <Properties>
                                        <Property Name="Preset" Value="TopCenter" />
                                        <Property Name="Offset" Value="0,20" />
                                    </Properties>
                                </Component>
                                <Component Type="LabelComponent">
                                    <Properties>
                                        <Property Name="Text" Value="WORLD-SPACE PANEL" />
                                        <Property Name="TextColor" Value="Orange" />
                                        <Property Name="Scale" Value="1.5,1.5" />
                                    </Properties>
                                </Component>
                            </Components>
                        </EntityDefinition>

                        <EntityDefinition
                            Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity"
                            Id="panelBodyText">
                            <Components>
                                <Component Type="AnchorComponent">
                                    <Properties>
                                        <Property Name="Preset" Value="MiddleCenter" />
                                        <Property Name="Offset" Value="0,0" />
                                    </Properties>
                                </Component>
                                <Component Type="LabelComponent">
                                    <Properties>
                                        <Property Name="Text"
                                            Value="Anchored inside the panel — move with WASD" />
                                        <Property Name="TextColor" Value="White" />
                                    </Properties>
                                </Component>
                            </Components>
                        </EntityDefinition>

                        <EntityDefinition
                            Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity"
                            Id="panelFooterText">
                            <Components>
                                <Component Type="AnchorComponent">
                                    <Properties>
                                        <Property Name="Preset" Value="BottomCenter" />
                                        <Property Name="Offset" Value="0,-16" />
                                    </Properties>
                                </Component>
                                <Component Type="LabelComponent">
                                    <Properties>
                                        <Property Name="Text"
                                            Value="camera follows the panel, not the screen" />
                                        <Property Name="TextColor" Value="Gray" />
                                    </Properties>
                                </Component>
                            </Components>
                        </EntityDefinition>
                    </Children>
                </EntityDefinition>

                <!--
                    Camera so the world-space panel can be panned around (WASD) to show that its
                    anchored children stay pinned inside it in world space, not screen space.
                    CameraComponent owns the camera and CameraInputComponent handles WASD/Q/E/R;
                    only the pan speed is raised (the default of 1 world unit/second is imperceptible).
                -->
                <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="camera">
                    <Position X="0" Y="0" />
                    <Components>
                        <Component Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.Components.BuiltIn.CameraComponent" />
                        <Component Type="CoreEssentials.Playground.Components.CameraInputComponent">
                            <Properties>
                                <Property Name="MoveSpeed" Value="300" />
                            </Properties>
                        </Component>
                    </Components>
                </EntityDefinition>

                <!-- Navigation keys: pure data, resolved via SceneManager.LoadScene(string). -->
                <EntityDefinition
                    Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity"
                    Id="navPhysics">
                    <Components>
                        <Component Type="CoreEssentials.Playground.Components.NavigateOnKeyComponent">
                            <Properties>
                                <Property Name="TriggerKey" Value="Escape" />
                                <Property Name="TargetSceneAsset" Value="Scenes/PhysicsEntityScene.xml" />
                            </Properties>
                        </Component>
                    </Components>
                </EntityDefinition>

                <EntityDefinition
                    Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity"
                    Id="navSendMessage">
                    <Components>
                        <Component Type="CoreEssentials.Playground.Components.NavigateOnKeyComponent">
                            <Properties>
                                <Property Name="TriggerKey" Value="M" />
                                <Property Name="TargetSceneAsset" Value="Scenes/SendMessageDemoScene.xml" />
                            </Properties>
                        </Component>
                    </Components>
                </EntityDefinition>
            </Entities>
        </System>
    </GameSystems>
</Scene>