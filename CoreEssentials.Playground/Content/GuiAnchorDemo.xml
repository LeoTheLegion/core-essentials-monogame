<Scene>
    <!--
        Fully data-driven anchored GUI demo (mirrors Unity's RectTransform anchoring).

        One root GameObjectEntity carries the CanvasComponent; every HUD element is a child
        composed of an AnchorComponent (preset + pixel offset) plus a LabelComponent or
        ButtonComponent. No per-element game code — only the button command wiring and the
        live score label are written in GuiAnchorDemoScene.cs.

        Anchors are normalized screen points: (0,0) = top-left, (1,1) = bottom-right.
    -->
    <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="hud">
        <Position X="0" Y="0" />
        <Components>
            <Component Type="CanvasComponent" />
            <Component Type="AnchorComponent">
                <Properties>
                    <Property Name="Preset" Value="TopLeft" />
                    <Property Name="Offset" Value="0,0" />
                </Properties>
            </Component>
        </Components>

        <Children>
            <!-- Title: top edge, centered horizontally -->
            <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="titleText">
                <Components>
                    <Component Type="AnchorComponent">
                        <Properties>
                            <Property Name="Preset" Value="TopCenter" />
                            <Property Name="Offset" Value="0,40" />
                        </Properties>
                    </Component>
                    <Component Type="LabelComponent">
                        <Properties>
                            <Property Name="Text" Value="CORE ESSENTIALS — ANCHORED GUI DEMO" />
                            <Property Name="TextColor" Value="White" />
                            <Property Name="Scale" Value="2,2" />
                        </Properties>
                    </Component>
                </Components>
            </EntityDefinition>

            <!-- Score: top-left corner (updated live at runtime by the scene) -->
            <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="scoreText">
                <Components>
                    <Component Type="AnchorComponent">
                        <Properties>
                            <Property Name="Preset" Value="TopLeft" />
                            <Property Name="Offset" Value="16,16" />
                        </Properties>
                    </Component>
                    <Component Type="LabelComponent">
                        <Properties>
                            <Property Name="Text" Value="Score: 0" />
                            <Property Name="TextColor" Value="Lime" />
                        </Properties>
                    </Component>
                </Components>
            </EntityDefinition>

            <!-- Hint: bottom edge, centered horizontally -->
            <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="hintText">
                <Components>
                    <Component Type="AnchorComponent">
                        <Properties>
                            <Property Name="Preset" Value="BottomCenter" />
                            <Property Name="Offset" Value="0,-32" />
                        </Properties>
                    </Component>
                    <Component Type="LabelComponent">
                        <Properties>
                            <Property Name="Text" Value="Click the buttons to change the score | Esc for next scene" />
                            <Property Name="TextColor" Value="Gray" />
                        </Properties>
                    </Component>
                </Components>
            </EntityDefinition>

            <!-- Buttons: left edge, vertically centered -->
            <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="addScoreButton">
                <Components>
                    <Component Type="AnchorComponent">
                        <Properties>
                            <Property Name="Preset" Value="MiddleLeft" />
                            <Property Name="Offset" Value="16,-25" />
                        </Properties>
                    </Component>
                    <Component Type="ButtonComponent">
                        <Properties>
                            <Property Name="Text" Value="Add 10" />
                        </Properties>
                    </Component>
                </Components>
            </EntityDefinition>

            <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="resetButton">
                <Components>
                    <Component Type="AnchorComponent">
                        <Properties>
                            <Property Name="Preset" Value="MiddleLeft" />
                            <Property Name="Offset" Value="16,25" />
                        </Properties>
                    </Component>
                    <Component Type="ButtonComponent">
                        <Properties>
                            <Property Name="Text" Value="Reset" />
                        </Properties>
                    </Component>
                </Components>
            </EntityDefinition>
        </Children>
    </EntityDefinition>

    <!--
        World-space panel: a second root with a world-space canvas (IsScreenSpace=false) and an
        explicit size in world units. Its anchored children live INSIDE the panel, so moving the
        camera (WASD) or the panel drags the whole anchored layout around the world.
    -->
    <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="worldPanel">
        <Position X="640" Y="360" />
        <Components>
            <Component Type="CanvasComponent">
                <Properties>
                    <Property Name="IsScreenSpace" Value="false" />
                    <Property Name="Width" Value="320" />
                    <Property Name="Height" Value="200" />
                </Properties>
            </Component>
        </Components>

        <Children>
            <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="panelTitleText">
                <Components>
                    <Component Type="AnchorComponent">
                        <Properties>
                            <Property Name="Preset" Value="TopCenter" />
                            <Property Name="Offset" Value="0,20" />
                        </Properties>
                    </Component>
                    <Component Type="LabelComponent">
                        <Properties>
                            <Property Name="Text" Value="WORLD-SPACE PANEL" />
                            <Property Name="TextColor" Value="Orange" />
                            <Property Name="Scale" Value="1.5,1.5" />
                        </Properties>
                    </Component>
                </Components>
            </EntityDefinition>

            <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="panelBodyText">
                <Components>
                    <Component Type="AnchorComponent">
                        <Properties>
                            <Property Name="Preset" Value="MiddleCenter" />
                            <Property Name="Offset" Value="0,0" />
                        </Properties>
                    </Component>
                    <Component Type="LabelComponent">
                        <Properties>
                            <Property Name="Text" Value="Anchored inside the panel — move with WASD" />
                            <Property Name="TextColor" Value="White" />
                        </Properties>
                    </Component>
                </Components>
            </EntityDefinition>

            <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="panelFooterText">
                <Components>
                    <Component Type="AnchorComponent">
                        <Properties>
                            <Property Name="Preset" Value="BottomCenter" />
                            <Property Name="Offset" Value="0,-16" />
                        </Properties>
                    </Component>
                    <Component Type="LabelComponent">
                        <Properties>
                            <Property Name="Text" Value="camera follows the panel, not the screen" />
                            <Property Name="TextColor" Value="Gray" />
                        </Properties>
                    </Component>
                </Components>
            </EntityDefinition>
        </Children>
    </EntityDefinition>
</Scene>
