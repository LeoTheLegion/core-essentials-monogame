<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>CoreEssentials.Physics</PackageId>
    <Version>0.15.0</Version>
    <Authors>LeoTheLegion</Authors>
    <Description>Physics engine with adapter pattern integration for CoreEssentials library</Description>
    <RepositoryUrl>https://github.com/LeoTheLegion/core-essentials-monogame</RepositoryUrl>
    <PackageProjectUrl>https://github.com/LeoTheLegion/core-essentials-monogame</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- References to Aether Physics2D -->
  <ItemGroup>
    <PackageReference Include="Aether.Physics2D.MG" Version="2.1.1" />
    <PackageReference Include="Aether.Physics2D.Diagnostics.MG" Version="2.1.1" />
  </ItemGroup>

  <!-- References to MonoGame for Vector2 -->
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- References to CoreEssentials library -->
  <ItemGroup>
    <ProjectReference Include="..\CoreEssentials\CoreEssentials.csproj" />
  </ItemGroup>

</Project>
